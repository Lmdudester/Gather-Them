# Path to the MTGJSON AllPrintings SQLite database
# Download from: https://mtgjson.com/downloads/all-files/
MTGJSON_DB_PATH=/path/to/AllPrintings.sqlite

# URL to download the MTGJSON AllPrintings SQLite zip
# MTGJSON_DOWNLOAD_URL=https://mtgjson.com/api/v5/AllPrintings.sqlite.zip

# Optional: secret token for admin access (submitted via login form)
# If not set, only Django staff users can access admin features.
ADMIN_SECRET=

# Django settings
SECRET_KEY=change-me-to-a-random-string
DEBUG=True
