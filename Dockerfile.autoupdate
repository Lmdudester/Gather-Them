# Minimal Gather Them container - clones and builds fresh on every start
FROM python:3.12-slim

# Install required tools
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Create directories
RUN mkdir -p /app/src /mtgjson-data

WORKDIR /app

# Environment
ENV MTGJSON_DB_PATH=/mtgjson-data/AllPrintings.sqlite
ENV DEBUG=True
ENV PORT=3007

# Copy entrypoint and fix line endings
COPY scripts/entrypoint-autoupdate.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 3007

ENTRYPOINT ["/entrypoint.sh"]
